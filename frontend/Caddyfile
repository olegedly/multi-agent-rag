:80 {
    root * /usr/share/caddy/html
    encode zstd gzip

    # Security headers (TLS/HSTS handled by Coolify's edge proxy)
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Hashed assets (Vite/SolidJS: assets/*-<hash>.{js,css}) — cache 1 year, immutable
    @assets {
        path *.js *.mjs *.css *.svg *.png *.jpg *.jpeg *.gif *.ico *.webp *.avif *.woff *.woff2
    }
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # HTML — short cache so browsers pick up new asset references quickly
    @html {
        path *.html
    }
    header @html Cache-Control "public, max-age=0, must-revalidate"

    # SPA fallback — serve index.html for client-side routes
    try_files {path} /index.html
    file_server

    # Reverse-proxy API requests to FastAPI backend
    reverse_proxy /api/* backend:8000
}
