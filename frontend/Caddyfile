:80 {
    encode zstd gzip

    # Security headers (TLS/HSTS handled by Coolify's edge proxy)
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Layer 1: IP rate limiting — only POST /api/chat (the expensive endpoint)
    @chat {
        method POST
        path /api/chat
    }
    handle @chat {
        rate_limit {
            zone api_rate {
                key {remote_host}
                events 10
                window 1m
            }
        }
        reverse_proxy backend:8000
    }

    # Other /api/ routes (health, capabilities) — proxied without rate limit
    @api {
        path_regexp ^/api/
    }
    handle @api {
        reverse_proxy backend:8000
    }

    # Static files with SPA fallback
    handle {
        root * /usr/share/caddy/html

        # Hashed assets — cache 1 year, immutable
        @assets {
            path *.js *.mjs *.css *.svg *.png *.jpg *.jpeg *.gif *.ico *.webp *.avif *.woff *.woff2
        }
        header @assets Cache-Control "public, max-age=31536000, immutable"

        # HTML — short cache
        @html {
            path *.html
        }
        header @html Cache-Control "public, max-age=0, must-revalidate"

        try_files {path} /index.html
        file_server
    }
}
